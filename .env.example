# ── CORE SERVER & PERSISTENT VOLUME ──────────────────────────
PORT=3000
NODE_ENV=production
RAILWAY_VOLUME_MOUNT_PATH=/app/data
DB_TYPE=sqlite
SQLITE_PATH=/app/data/urooj_suite.db

# ── AI STUDIO FRONTEND <-> RAILWAY BACKEND BRIDGE ────────────
# Set RAILWAY_BACKEND_URL to your public Railway https://xxxx.up.railway.app URL
RAILWAY_BACKEND_URL=
PERMANENT_AUTH_SECRET=urooj-master-permanent-secret-923299931199
AUTO_REAUTH_ENABLED=true
CORS_ORIGIN=*
KEEP_ALIVE_INTERVAL_MS=45000

# ── BOT IDENTITY & OWNER CONFIGURATION ───────────────────────
BOT_NAME=Urooj Choudhary
BOT_OWNER=King Unkown
OWNER_NUMBER=923299931199
PREFIX=.
COMMAND_MODE=public
TIMEZONE=Asia/Karachi
SESSION_ID=

# ── WHATSAPP AUTOMATION TOGGLES ──────────────────────────────
AUTOREAD=false
AUTOTYPE=false
AUTORECORD=false
AUTORECORDTYPE=false
AUTO_STATUS_REACT=true
AUTO_STATUS_REPLY=false
AUTO_STATUS_MSG=
ALWAYSONLINE=true
BUTTONMODE=on
PACK_AUTHOR=Urooj Choudhary
PACK_NAME=King Unkown

# ── OPTIONAL EXTERNAL SERVICES ───────────────────────────────
